# Application environment
APP_ENV=development

# Required YouTube Data API credential
YOUTUBE_API_KEY=

# Comma-separated production origins. Example:
# ALLOWED_ORIGINS=https://clipfender.example,https://www.clipfender.example
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Search guardrails
SEARCH_DAILY_GUARD=70
SEARCH_REQUEST_MIN_INTERVAL=0.35
SEARCH_RATE_LIMIT=30
SEARCH_RATE_WINDOW=60

# Optional contact delivery (at least one provider can be configured)
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
CONTACT_SMTP_TLS=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional local/testing database override; production defaults to ./clipfinder.db
# CLIPFINDER_DB_PATH=

# Admin panel — comma-separated allowlist of exact user emails
# Leave empty to disable admin access.
ADMIN_EMAILS=
# First-deploy bootstrap secret. It is used only if the allowlisted admin account does not exist yet.
# After the admin logs in successfully, remove this secret from production.
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=ClipFender Admin

# Logging
LOG_LEVEL=INFO

# Public URL / SEO
PUBLIC_BASE_URL=https://clipfender.example

# Automatic character portrait discovery
# The legacy Bing Image Search integration is retired and intentionally disabled.
# New characters use the OpenAI generation fallback when enabled and configured.
CHARACTER_IMAGE_SEARCH_ENABLED=0
BING_IMAGE_SEARCH_API_KEY=
BING_IMAGE_SEARCH_ENDPOINT=
CHARACTER_IMAGE_SEARCH_COUNT=12
CHARACTER_IMAGE_SEARCH_ALLOWED_HOSTS=

# Automatic AI portrait generation fallback
CHARACTER_IMAGE_GENERATION_ENABLED=1
OPENAI_API_KEY=
OPENAI_IMAGE_ENDPOINT=https://api.openai.com/v1/images/generations
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
CHARACTER_STORAGE_DIR=data/characters
TRUST_PROXY_HEADERS=0

# Quality/cost guardrails for new catalog entries
CHARACTER_IMAGE_MIN_SHORT_SIDE=900
CHARACTER_IMAGE_MAX_BYTES=12000000
CHARACTER_IMAGE_MIN_EDGE_SCORE=7
CHARACTER_DISCOVERY_RATE_LIMIT=3
CHARACTER_DISCOVERY_RATE_WINDOW=86400
CHARACTER_GENERATION_DAILY_GUARD=10

# Optional privacy-friendly analytics. Leave empty to disable analytics and consent banner.
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
