# ClipFender local/development environment
APP_ENV=development

# Required for live YouTube search
YOUTUBE_API_KEY=

# Local development defaults; production should contain the exact HTTPS site origin.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Search guardrails
SEARCH_DAILY_GUARD=70
SEARCH_REQUEST_MIN_INTERVAL=0.35
SEARCH_RATE_LIMIT=30
SEARCH_RATE_WINDOW=60

# Optional contact delivery
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
CONTACT_SMTP_TLS=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin access
ADMIN_EMAILS=
ADMIN_BOOTSTRAP_PASSWORD=

# Persistent production datastore (Turso/libSQL). Leave empty to use local SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Automatic character portraits. Internet image search is intentionally disabled.
# Legacy Bing fields are retained for backward-compatible .env files; do not use them.
CHARACTER_IMAGE_SEARCH_ENABLED=0
BING_IMAGE_SEARCH_API_KEY=
BING_IMAGE_SEARCH_ENDPOINT=
CHARACTER_IMAGE_SEARCH_COUNT=12
CHARACTER_IMAGE_SEARCH_ALLOWED_HOSTS=
CHARACTER_IMAGE_GENERATION_ENABLED=1
OPENAI_API_KEY=
OPENAI_IMAGE_ENDPOINT=https://api.openai.com/v1/images/generations
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
CHARACTER_IMAGE_MIN_SHORT_SIDE=900
CHARACTER_IMAGE_MAX_BYTES=12000000
CHARACTER_IMAGE_MIN_EDGE_SCORE=7
CHARACTER_DISCOVERY_RATE_LIMIT=3
CHARACTER_DISCOVERY_RATE_WINDOW=86400
CHARACTER_GENERATION_DAILY_GUARD=10

# Optional privacy-friendly analytics
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# Optional local SQLite override. Do not use this in Render Free production.
# CLIPFINDER_DB_PATH=
